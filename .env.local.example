# yfinance and ccxt/Coinbase public endpoints need no credentials.
# These are placeholders for when AlpacaDataSource gets a real implementation.
# Copy this file to .env.local (gitignored) and fill in real values there —
# never commit actual keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Execution / broker integration
EXECUTION_MODE=simulated
ALPACA_PAPER=true
CRYPTO_EXCHANGE_ID=coinbaseexchange
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=
CCXT_SANDBOX=false
DISCORD_WEBHOOK_URL=
ALLOW_EXTENDED_HOURS=false
MAX_CORRELATED_EXPOSURE_PCT=0.35
MARKET_TIMEZONE=America/New_York

LIVE_TRADING_CONFIRM=
